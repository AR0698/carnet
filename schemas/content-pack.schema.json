{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ar0698.github.io/carnet/schemas/content-pack.schema.json",
  "title": "ContentPack",
  "description": "Pack de contenu générique pour le moteur de répétition espacée. Agnostique du sujet : le moteur ne connaît que topics, items et exercises.",
  "type": "object",
  "required": ["meta", "topics", "items"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "subject", "version", "schemaVersion", "locale"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "locale": {
          "description": "Langue des consignes, indices et explications.",
          "type": "string",
          "minLength": 2
        },
        "contentLocale": {
          "description": "Langue de la matière elle-même, si elle diffère des consignes. C'est celle qui est lue à voix haute.",
          "type": "string",
          "minLength": 2
        }
      }
    },

    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "prerequisites"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "prerequisites": {
            "description": "Ordre suggéré de progression, jamais un verrou d'accès.",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "lesson": { "$ref": "#/$defs/lesson" }
        }
      }
    },

    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topicId", "tags", "fields", "exercises"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topicId": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "fields": {
            "description": "Données brutes libres, spécifiques au sujet. Non interprétées par le moteur.",
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/exercise" }
          }
        }
      }
    }
  },

  "$defs": {
    "lesson": {
      "description": "La fiche de cours d'une notion : l'endroit où on va comprendre. Tient sur un écran, se lit dans un ordre fixe — image, règle, contraste, piège du francophone, exemples.",
      "type": "object",
      "required": ["image", "rule", "trap", "examples"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "description": "L'accroche mentale : la règle attachée à quelque chose qui se voit.",
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "rule": {
          "description": "La règle en une phrase, si possible sous forme d'équation.",
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "figure": {
          "description": "Le dessin de la règle : un axe du temps, ses durées et ses instants.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "now": { "type": "string", "minLength": 1, "maxLength": 24 },
            "spans": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to", "label"],
                "additionalProperties": false,
                "properties": {
                  "from": { "type": "number", "minimum": 0, "maximum": 100 },
                  "to": { "type": "number", "minimum": 0, "maximum": 100 },
                  "label": { "type": "string", "minLength": 1, "maxLength": 48 },
                  "open": { "enum": ["left", "right", "both"] },
                  "tone": { "enum": ["strong", "quiet"] }
                }
              }
            },
            "marks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["at", "label"],
                "additionalProperties": false,
                "properties": {
                  "at": { "type": "number", "minimum": 0, "maximum": 100 },
                  "label": { "type": "string", "minLength": 1, "maxLength": 48 }
                }
              }
            }
          }
        },
        "contrast": {
          "description": "Les deux formes que l'unité sert à distinguer, et ce qui les sépare.",
          "type": "object",
          "required": ["left", "right", "note"],
          "additionalProperties": false,
          "properties": {
            "left": { "type": "string", "minLength": 1, "maxLength": 90 },
            "right": { "type": "string", "minLength": 1, "maxLength": 90 },
            "note": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "trap": {
          "description": "Le calque du français : la faute qu'on fait parce que la phrase française est construite autrement.",
          "type": "object",
          "required": ["wrong", "right", "why"],
          "additionalProperties": false,
          "properties": {
            "wrong": { "type": "string", "minLength": 1, "maxLength": 120 },
            "right": { "type": "string", "minLength": 1, "maxLength": 120 },
            "why": { "type": "string", "minLength": 1, "maxLength": 220 }
          }
        },
        "examples": {
          "description": "Deux registres, pas un de plus : la ville et le travail.",
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["register", "en", "fr"],
            "additionalProperties": false,
            "properties": {
              "register": { "enum": ["bristol", "work"] },
              "en": { "type": "string", "minLength": 1, "maxLength": 140 },
              "fr": { "type": "string", "minLength": 1, "maxLength": 140 }
            }
          }
        },
        "seeAlso": {
          "description": "Les unités voisines — celles qu'on confond avec celle-ci.",
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "answerSpec": {
      "type": "object",
      "required": ["accepted"],
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "description": "Réponses acceptées. La première sert de réponse canonique affichée en correction.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "caseSensitive": { "type": "boolean", "default": false },
        "ignoreAccents": { "type": "boolean", "default": true }
      }
    },

    "exercise": {
      "type": "object",
      "required": ["type", "prompt", "answerSpec"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["produce", "fill_blank", "spot_error", "transform", "mcq"]
        },
        "prompt": { "type": "string", "minLength": 1 },
        "source": {
          "description": "Phrase de départ, affichée à part : la phrase à transformer (transform) ou la phrase fautive à corriger (spot_error).",
          "type": "string",
          "minLength": 1
        },
        "answerSpec": { "$ref": "#/$defs/answerSpec" },
        "hints": {
          "description": "Rappel de règle court, une phrase.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pitfalls": {
          "description": "Erreurs anticipées et leur explication, servies hors ligne au moment de la correction.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["answers", "explain"],
            "additionalProperties": false,
            "properties": {
              "answers": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "explain": { "type": "string", "minLength": 1 }
            }
          }
        },
        "distractors": {
          "description": "Uniquement pour mcq : mauvaises réponses proposées.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "mcq" } }, "required": ["type"] },
          "then": { "required": ["distractors"], "properties": { "distractors": { "minItems": 2 } } },
          "else": { "not": { "required": ["distractors"] } }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["transform", "spot_error"] } },
            "required": ["type"]
          },
          "then": { "required": ["source"] }
        },
        {
          "if": { "properties": { "type": { "const": "fill_blank" } }, "required": ["type"] },
          "then": { "properties": { "prompt": { "pattern": "___" } } }
        }
      ]
    }
  }
}
